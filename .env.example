# ==============================================================================
# 1. DISCORD BOT CONFIGURATION / CẤU HÌNH BOT DISCORD
# ==============================================================================

# Discord Bot authentication token (Get from Discord Developer Portal -> Bot -> Token)
# Token xác thực của Bot Discord (Lấy từ Discord Developer Portal -> Bot -> Token)
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Target Discord Guild (Server) ID to monitor (Enable Developer Mode in Discord -> Right-click server -> Copy Server ID)
# ID của máy chủ Discord cần giám sát (Bật Developer Mode trên Discord -> Click chuột phải vào máy chủ -> Copy Server ID)
TARGET_GUILD_ID=708718758616760339

# Log Channel ID where bot will send log message events (Right-click channel -> Copy Channel ID)
# ID kênh văn bản để bot gửi các thông báo nhật ký (Click chuột phải vào kênh -> Copy Channel ID)
LOG_CHANNEL_ID=879961838043922432

# Path to the local SQLite database file
# Đường dẫn lưu tệp cơ sở dữ liệu SQLite cục bộ
DB_PATH=chatlog.db

# Directory for transient media caching
# Thư mục lưu trữ tạm thời khi tải file đa phương tiện
CACHE_DIR=mediacache


# ==============================================================================
# 2. SYSTEM LANGUAGE & REPORT MODES / CẤU HÌNH NGÔN NGỮ VÀ BÁO CÁO
# ==============================================================================

# Bot interface and message language: 'vi' (Vietnamese) or 'en' (English)
# Ngôn ngữ hiển thị của bot: 'vi' (Tiếng Việt) hoặc 'en' (Tiếng Anh)
BOT_LANG=vi

# Periodic report schedule: 'hourly' (every hour) or 'daily' (every 24 hours)
# Chu kỳ tạo và gửi báo cáo định kỳ: 'hourly' (mỗi giờ) hoặc 'daily' (mỗi ngày)
REPORT_TASK_SCHED=hourly

# Send periodic reports to the main log channel: True or False
# Tự động gửi báo cáo định kỳ vào kênh log chính: True hoặc False
ALSO_SEND_TO_LOG_CHANNEL=True


# ==============================================================================
# 3. PERFORMANCE LIMITS / GIỚI HẠN HIỆU NĂNG HỆ THỐNG
# ==============================================================================
# Warning: Do not modify these values unless you know what you are doing.
# Cảnh báo: Không nên thay đổi nếu không hiểu rõ về kiến trúc hàng đợi.

MAX_DB_QUEUE_SIZE=10000
MAX_LOG_QUEUE_SIZE=5000
LOG_CONSUMER_WORKERS_COUNT=3
MAX_PARALLEL_DOWNLOADS=16
MAX_PARALLEL_SCANS=30
SCAN_SIZE=3500
MAX_PAYLOAD_BYTES_LIMIT=7800000
